generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────

enum UserRole {
  SUPER_ADMIN
  SOCIETY_ADMIN
  RESIDENT
  STAFF
  VENDOR
}

enum SocietyStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum FlatStatus {
  VACANT
  OCCUPIED
  BLOCKED
}

enum FlatType {
  ONE_BHK
  TWO_BHK
  THREE_BHK
  FOUR_BHK
  PENTHOUSE
}

enum ComplaintPriority {
  LOW
  MEDIUM
  HIGH
  EMERGENCY
}

enum ComplaintStatus {
  OPEN
  ASSIGNED
  ACCEPTED
  IN_PROGRESS
  RESOLVED
  CLOSED
  REOPENED
}

enum AssignmentStatus {
  ASSIGNED
  ACCEPTED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

// ─────────────────────────────────────────────
// MODELS
// ─────────────────────────────────────────────

model Society {
  id                 String        @id @default(cuid())
  name               String
  societyCode        String        @unique
  registrationNumber String?       @unique
  address            String
  city               String
  state              String
  pincode            String
  contactEmail       String        @unique
  contactPhone       String
  logo               String?
  status             SocietyStatus @default(ACTIVE)
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  createdById String?

  createdBy         User?              @relation("SocietyCreator", fields: [createdById], references: [id], onDelete: SetNull)
  users             User[]
  flats             Flat[]
  residents         Resident[]
  staff             Staff[]
  complaints        Complaint[]
  vendorAssignments VendorAssignment[]
  staffAssignments  StaffAssignment[]

  @@index([societyCode])
  @@index([status])
  @@index([createdById])
}

model User {
  id            String   @id @default(cuid())
  name          String
  firstName     String
  lastName      String
  email         String?  @unique
  phone         String?  @unique
  emailVerified Boolean  @default(false)
  role          UserRole
  societyId     String?
  image         String?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  createdSocieties Society[] @relation("SocietyCreator")

  society             Society?                 @relation(fields: [societyId], references: [id])
  resident            Resident?
  staff               Staff?
  vendor              Vendor?
  sessions            Session[]
  accounts            Account[]
  assignedAssignments VendorAssignment[]       @relation("AssignmentAssignedBy")
  assignedStaffAssignments StaffAssignment[]   @relation("StaffAssignmentAssignedBy")
  statusChanges       ComplaintStatusHistory[]
  notifications       Notification[]
  pushSubscriptions   PushSubscription[]

  @@index([societyId])
  @@index([role])
}

model Flat {
  id         String     @id @default(cuid())
  societyId  String
  flatNumber String
  wing       String?
  floor      Int
  type       FlatType
  status     FlatStatus @default(VACANT)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  society    Society     @relation(fields: [societyId], references: [id], onDelete: Cascade)
  resident   Resident?
  complaints Complaint[]

  @@unique([societyId, flatNumber])
  @@index([societyId])
}

model Resident {
  id           String   @id @default(cuid())
  userId       String   @unique
  societyId    String
  flatId       String   @unique
  residentType String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  society Society @relation(fields: [societyId], references: [id], onDelete: Cascade)
  flat    Flat    @relation(fields: [flatId], references: [id], onDelete: Cascade)

  complaints Complaint[]

  @@index([societyId])
}

model Staff {
  id          String    @id @default(cuid())
  userId      String    @unique
  societyId   String
  role        String
  department  String
  joiningDate DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  society Society @relation(fields: [societyId], references: [id], onDelete: Cascade)

  assignments StaffAssignment[]

  @@index([societyId])
  @@index([userId])
}

model Vendor {
  id           String   @id @default(cuid())
  userId       String   @unique
  companyName  String
  category     String
  contractType String?
  description  String?
  address      String?
  city         String?
  state        String?
  pincode      String?
  isAvailable  Boolean  @default(true)
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user        User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  assignments VendorAssignment[]

  @@index([userId])
  @@index([category])
  @@index([isAvailable])
}

model Complaint {
  id          String            @id @default(cuid())
  societyId   String
  residentId  String
  flatId      String
  title       String
  description String?
  category    String
  priority         ComplaintPriority @default(MEDIUM)
  status           ComplaintStatus   @default(OPEN)
  imageUrl         String?
  afterImageUrl    String?
  satisfiedAt      DateTime?
  satisfactionNote String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  society           Society                  @relation(fields: [societyId], references: [id], onDelete: Cascade)
  resident          Resident                 @relation(fields: [residentId], references: [id], onDelete: Cascade)
  flat              Flat                     @relation(fields: [flatId], references: [id], onDelete: Cascade)
  vendorAssignments VendorAssignment[]
  staffAssignments  StaffAssignment[]
  statusHistory     ComplaintStatusHistory[]
  notifications     Notification[]

  @@index([societyId])
  @@index([residentId])
  @@index([status])
}

model ComplaintStatusHistory {
  id                 String          @id @default(cuid())
  complaintId        String
  status             ComplaintStatus
  changedById        String?
  note               String?
  resolutionImageUrl String?
  createdAt          DateTime        @default(now())

  complaint Complaint @relation(fields: [complaintId], references: [id], onDelete: Cascade)
  changedBy User?     @relation(fields: [changedById], references: [id], onDelete: SetNull)

  @@index([complaintId])
  @@index([createdAt])
}

model VendorAssignment {
  id           String           @id @default(cuid())
  vendorId     String
  societyId    String
  complaintId  String
  assignedById String?
  status       AssignmentStatus @default(ASSIGNED)
  assignedAt   DateTime         @default(now())
  acceptedAt   DateTime?
  startedAt    DateTime?
  completedAt  DateTime?
  cancelledAt  DateTime?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  vendor     Vendor    @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  society    Society   @relation(fields: [societyId], references: [id], onDelete: Cascade)
  complaint  Complaint @relation(fields: [complaintId], references: [id], onDelete: Cascade)
  assignedBy User?     @relation("AssignmentAssignedBy", fields: [assignedById], references: [id], onDelete: SetNull)

  @@index([vendorId])
  @@index([societyId])
  @@index([complaintId])
  @@index([status])
}

model StaffAssignment {
  id           String           @id @default(cuid())
  staffId      String
  societyId    String
  complaintId  String
  assignedById String?
  status       AssignmentStatus @default(ASSIGNED)
  assignedAt   DateTime         @default(now())
  acceptedAt   DateTime?
  startedAt    DateTime?
  completedAt  DateTime?
  cancelledAt  DateTime?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  staff      Staff     @relation(fields: [staffId], references: [id], onDelete: Cascade)
  society    Society   @relation(fields: [societyId], references: [id], onDelete: Cascade)
  complaint  Complaint @relation(fields: [complaintId], references: [id], onDelete: Cascade)
  assignedBy User?     @relation("StaffAssignmentAssignedBy", fields: [assignedById], references: [id], onDelete: SetNull)

  @@index([staffId])
  @@index([societyId])
  @@index([complaintId])
  @@index([status])
}

model Notification {
  id          String   @id @default(cuid())
  userId      String
  complaintId String?
  type        String
  title       String
  message     String
  isRead      Boolean  @default(false)
  createdAt   DateTime @default(now())

  user     User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  complaint Complaint? @relation(fields: [complaintId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([isRead])
  @@index([complaintId])
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, endpoint])
  @@index([userId])
}

// ─────────────────────────────────────────────
// BETTER AUTH TABLES (do not modify)
// ─────────────────────────────────────────────

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime
  updatedAt             DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime
  updatedAt DateTime
  ipAddress String?
  userAgent String?
  userId    String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Verification {
  id         String    @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime?
  updatedAt  DateTime?
}
